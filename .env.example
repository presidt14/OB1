# Required environment variables for Open Brain
# Set these as Supabase Edge Function secrets via:
#   supabase secrets set KEY=value

# Auto-injected by Supabase — no need to set manually:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Slack (https://api.slack.com/apps → OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CAPTURE_CHANNEL=C0XXXXXXXXX   # Channel ID, not name

# MCP server auth — pick any random secret string
MCP_ACCESS_KEY=your-random-secret-key
